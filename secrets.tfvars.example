# AWS region for the deployment
aws_region = "us-east-1"

# Optional email address for SNS security alerts.
# You will receive an AWS SNS confirmation email after deployment.
notification_email = "your-email@example.com"

# Optional secrets.
#
# Leave these commented out to let Terraform automatically
# generate demo values for the Secrets Manager demonstration.
#
# api_key     = "your-api-key"
# oauth_token = "your-oauth-token"
# other_secret = "your-other-secret"